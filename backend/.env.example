# ============================================================================
# REAL ESTATE MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# 
# 12-Factor App Compliance: Factor 3 (Configuration)
# 
# Instructions:
# 1. Copy this file to .env (in the backend directory)
# 2. Update values for your environment
# 3. NEVER commit .env to version control
# 4. In production, set these as actual environment variables in your 
#    deployment platform (AWS/Docker/Kubernetes/etc.)
#
# ============================================================================

# ==== ENVIRONMENT & DEPLOYMENT ====
# Values: development, staging, production
ENVIRONMENT=development

# Enable detailed error messages and auto-reload (development only!)
DEBUG=false

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# ==== SERVER CONFIGURATION ====
# Host: 0.0.0.0 to listen on all interfaces (Docker/Cloud requirement)
# Port: Service port (exposed in Docker)
HOST=0.0.0.0
PORT=8000

# Number of Uvicorn worker processes (2-4x CPU cores recommended)
WORKERS=4

# ==== DATABASE CONNECTION (BACKING SERVICE) ====
# Format: postgresql://username:password@host:port/database
# 
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/real_estate
#   Docker: postgresql://postgres:password@postgres:5432/real_estate
#   Cloud: postgresql://user:pass@aws-rds-instance.xyz:5432/real_estate
#
# IMPORTANT: Use strong passwords in production. Use AWS Secrets Manager, 
#            Azure Key Vault, or similar in cloud environments
DATABASE_URL=postgresql://postgres:your-strong-password@localhost:5432/real_estate

# Optional read replica for read-only queries (reads go to the primary when unset).
# Point this at a streaming-replication standby in production to offload read traffic.
# DATABASE_REPLICA_URL=postgresql://postgres:your-strong-password@replica-host:5432/real_estate

# Database connection pool settings
# Adjust based on your application's concurrency needs
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_STATEMENT_TIMEOUT_MS=30000
MAX_PAGE_SIZE=500
MAX_REQUEST_BODY_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=redis://localhost:6379/0

# File uploads (magic-byte validated types: JPEG, PNG, GIF, WebP, PDF)
UPLOAD_DIR=uploads/property_media
MAX_UPLOAD_FILE_BYTES=10485760
# Generated lease/invoice PDFs (relative to backend/, or absolute)
DOCUMENTS_DIR=uploads/documents

# Password reset & history
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HISTORY_LIMIT=5

# Multi-factor authentication (TOTP / SMS backup / recovery codes)
MFA_ISSUER_NAME=PropNoxa
MFA_TOKEN_EXPIRE_MINUTES=5
MFA_SMS_CODE_EXPIRE_MINUTES=5
MFA_RECOVERY_CODE_COUNT=10
# Set true in production: admin accounts must enrol MFA before logging in
MFA_MANDATORY_FOR_ADMIN=false

# Transactional email. console = log instead of sending (dev/test default);
# smtp = deliver via SMTP_HOST (SES/Mailgun SMTP relay, Mailhog, Gmail, ...).
EMAIL_BACKEND=console
EMAIL_FROM="PropNoxa <no-reply@propnoxa.com>"
# Required when EMAIL_BACKEND=smtp; credentials come from a secrets manager in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# SMS (MFA backup codes, high-priority alerts). console = log instead of
# sending (dev/test default); twilio = fails closed until TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN and TWILIO_FROM_NUMBER are set (from a secrets manager).
SMS_BACKEND=console

# Payment gateway. mock = fully working in-process gateway (dev/test default,
# rejected in production); stripe/paypal/mpesa require provider credentials
# from a secrets manager before they activate.
PAYMENT_GATEWAY=mock
# HMAC secret verifying gateway webhook signatures (X-Webhook-Signature header).
# Required for webhook ingestion. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_WEBHOOK_SECRET=

# Database backups
BACKUP_DIR=backups/database
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MINIMUM=7
BACKUP_INTERVAL_HOURS=24
BACKUP_VERIFY_AFTER_CREATE=true
# Physical base backups are the anchor for point-in-time recovery (PostgreSQL only)
BACKUP_PHYSICAL_ENABLED=false
BACKUP_PHYSICAL_KEEP_COUNT=4
# Second location for the same files (mounted bucket / replicated volume)
# BACKUP_SECONDARY_DIR=/mnt/cross-region-backups
# BACKUP_WAL_ARCHIVE_DIR=/pg_wal_archive

# ==== DATA RETENTION (GDPR storage limitation) ====
# Legal/litigation hold: when true, destructive purges of business records
# (audit logs, notifications) are suspended. Ephemeral auth tokens are still purged.
LEGAL_HOLD_ENABLED=false
# Expired/used one-time tokens are purged this many days after expiry/use
RETENTION_TOKEN_GRACE_DAYS=30
# Audit log entries older than this many days are pruned (0 = keep forever)
RETENTION_AUDIT_LOG_DAYS=365
# Read notifications older than this are pruned; unread get double the window
RETENTION_NOTIFICATIONS_DAYS=180

# Enable SQL query logging (development/debugging only!)
DATABASE_ECHO=false

# Test database (optional - for running tests)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_test

# ==== SECURITY & SECRETS ====
# CRITICAL: These are sensitive values!
# 
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# In production, use a secrets manager:
#   - AWS Secrets Manager
#   - Azure Key Vault
#   - HashiCorp Vault
#   - Kubernetes Secrets
#   - Google Secret Manager
#
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-32

# JWT token algorithm
ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== CORS SETTINGS ====
# Comma-separated list of allowed origins for cross-origin requests
# 
# CRITICAL SECURITY: In production, ONLY allow your actual frontend domain(s)
# Never use wildcard (*) or localhost in production
#
# Development:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#
# Production (example):
#   CORS_ORIGINS=https://app.example.com,https://www.example.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

CORS_ALLOW_CREDENTIALS=true

# ==== HEALTH CHECKS & MONITORING ====
# Enable health check endpoints for container orchestration
# Required for Kubernetes, Docker Swarm, AWS ECS, etc.
ENABLE_HEALTH_CHECK=true

# Kubernetes liveness probe endpoint
LIVENESS_PROBE_PATH=/health/live

# Kubernetes readiness probe endpoint
READINESS_PROBE_PATH=/health/ready

# Startup timeout for readiness probe (seconds)
STARTUP_TIMEOUT_SECONDS=30

# ==== LOGGING ====
# Log format: json (for cloud aggregation) or text (for local development)
LOG_FORMAT=json

# Write logs to file (optional - usually disabled for containers; production
# retention belongs to the platform capturing stdout). Rotates at 10 MB, keeps 5.
LOG_TO_FILE=false

# Log file path (if LOG_TO_FILE=true)
# LOG_FILE_PATH=/var/log/app/application.log

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# LOCAL DEVELOPMENT:
#   - Copy this to .env and update values
#   - Uvicorn auto-reload works with DEBUG=true
#
# DOCKER CONTAINER:
#   - Set environment variables in docker-compose.yml or docker run -e
#   - HOST must be 0.0.0.0 to accept connections outside container
#   - Use container networking (postgres:5432 instead of localhost:5432)
#
# KUBERNETES:
#   - Store secrets in Kubernetes Secrets
#   - Reference via valueFrom.secretKeyRef in Pod spec
#   - Use ConfigMaps for non-secret configuration
#   - Liveness/readiness probes call /health/live and /health/ready
#
# AWS/CLOUD:
#   - Use AWS Secrets Manager for DATABASE_URL, SECRET_KEY, etc.
#   - Use IAM roles for automatic credential injection
#   - Set environment variables via deployment configuration
#   - Enable CloudWatch/X-Ray for structured logging
#
# ============================================================================
