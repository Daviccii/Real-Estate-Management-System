    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.11",
    "@types/react-router-dom": "^5.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^30.1.2",
    "typescript": "^5.4.2",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
